# انسخ هذا الملف باسم .env على الخادم، ثم استبدل القيم المطلوبة.
# لا تضع مفتاح OpenAI الحقيقي في Git أو في README.

APP_ENV=production
SECRET_KEY=

# محادثة عارف الذكية
ASSISTANT_AI_ENABLED=1
# الوضع التلقائي الآمن: يستخدم الذكاء الخارجي للأسئلة العامة النظيفة فقط،
# ويبقي بيانات النظام والمحتوى الحكومي محليًا، ويعود للمحلي عند تعذر الإنترنت.
ASSISTANT_AI_PRIVACY_MODE=PUBLIC_ONLY
ASSISTANT_AI_PUBLIC_MAX_CHARS=600
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6-luna
ASSISTANT_AI_TIMEOUT=20
ASSISTANT_AI_CONTEXT_CHARS=16000
ASSISTANT_AI_MAX_OUTPUT_TOKENS=1100

# معرفة المشروع المحلية
ASSISTANT_PROJECT_KNOWLEDGE_ENABLED=1
ASSISTANT_INDEX_REFRESH_SECONDS=300
