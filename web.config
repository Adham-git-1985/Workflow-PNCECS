<?xml version="1.0" encoding="utf-8"?>
<!-- IIS request filtering must allow full backup archives to reach Flask. -->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <!-- 1 GiB; the Flask restore route performs its own archive checks. -->
        <requestLimits maxAllowedContentLength="1073741824" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
